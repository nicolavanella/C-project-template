{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Project: Clean Build",
            "type": "shell",
            "windows": {
                "command": "if (Test-Path build) { Remove-Item -Recurse -Force build/* }"
            },
            "osx": {
                "command": "rm -rf build/*"
            },
            "linux": {
                "command": "rm -rf build/*"
            },
            "problemMatcher": [],
            "group": "none"
        },
        {
            "label": "CMake: Configure",
            "type": "cmake",
            "command": "configure",
            "problemMatcher": [],
            "group": "none"
        },
        {
            "label": "CMake: Build",
            "type": "cmake",
            "command": "build",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": [
                "CMake: Configure"
            ]
        }
    ]
}
